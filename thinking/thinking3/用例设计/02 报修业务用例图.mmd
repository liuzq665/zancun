flowchart LR
    student[学生]
    manager[宿管]
    worker[维修人员]
    admin[系统管理员]

    subgraph REPAIR[报修管理子系统]
        direction TB
        r1([R01 提交报修工单])
        r2([R02 审核报修工单])
        r3([R03 自动派单])
        r4([R04 手动强制派单])
        r5([R05 处理自动派单])
        r6([R06 现场维修并提交结果])
        r7([R07 申请和审核维修延期])
        r8([R08 确认维修并评价])
        r9([R09 申请重修])
        r10([R10 处理异常和无可派人员])
        r11([R11 配置报修规则和基础数据])
        r12([R12 查询和统计报修数据])
        notify([发送业务通知])
        timeout([超时和自动状态处理])
    end

