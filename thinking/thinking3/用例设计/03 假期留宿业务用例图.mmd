flowchart LR
    student[学生]
    manager[宿管]
    admin[系统管理员]

    subgraph STAY[假期留宿子系统]
        direction TB
        s1([S01 配置留宿开放区间和说明])
        s2([S02 发布留宿批次和申请规则])
        s3([S03 提交假期留宿申请])
        s4([S04 锁定留宿申请])
        s5([S05 审核留宿申请])
        s6([S06 修改并重新提交申请])
        s7([S07 处理逾期补录和人工添加])
        s8([S08 完成归档和统计])
        validate([校验开放区间和时间段])
        archive([按时间自动完成和归档])
        notify([发送留宿通知])
    end

    admin --- s1
    admin --- s7
    admin --- s8
    manager --- s2
    manager --- s4
    manager --- s5
    manager --- s7
    manager --- s8
    student --- s3
    student --- s6
    student --- s8

    s3 -.->|include| validate
    s6 -.->|include| validate
    s2 -.->|include| notify
    s3 -.->|include| notify
    s5 -.->|include| notify
    s6 -.->|include| notify
    s4 -.->|include| notify
    s8 -.->|include| archive
    s5 -.->|extend| s6
    s7 -.->|extend| s5

    classDef actor fill:#f5f5f5,stroke:#555,stroke-width:1px,color:#111
    classDef usecase fill:#eaf2f8,stroke:#39739d,stroke-width:1px,color:#111
    classDef internal fill:#fff4db,stroke:#b8860b,stroke-width:1px,color:#111
    class student,manager,admin actor
    class s1,s2,s3,s4,s5,s6,s7,s8 usecase
