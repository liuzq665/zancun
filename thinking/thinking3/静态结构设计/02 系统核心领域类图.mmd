classDiagram
    direction LR

    class SysUser {
        +Long userId
        +String loginAccount
        +String passwordHash
        +String realName
        +String phone
        +Boolean enabled
        +assignRole(Role role)
        +changePassword(String newHash)
    }

    class Role {
        +Long roleId
        +String code
        +String name
        +Boolean enabled
        +hasPermission(String permissionCode) Boolean
    }

    class Permission {
        +Long permissionId
        +String code
        +String name
        +String type
        +Boolean enabled
    }

    class UserRole {
        +Long userRoleId
        +LocalDateTime grantedAt
        +LocalDateTime expiredAt
        +Boolean active()
    }

    class RolePermission {
        +Long rolePermissionId
        +LocalDateTime grantedAt
    }

    class StudentProfile {
        +Long studentProfileId
        +String studentNo
        +String departmentName
        +String majorName
        +String className
        +String enrollmentStatus
    }

    class DormManagerProfile {
        +Long managerProfileId
        +String employeeNo
        +Boolean onDuty
        +String remark
    }

    class RepairerProfile {
        +Long repairerProfileId
        +String employeeNo
        +Boolean onDuty
        +Long maxActiveOrders
        +String remark
    }

    class Building {
        +Long buildingId
        +String name
        +String address
        +String genderLimit
        +String usageStatus
        +Boolean available()
    }

    class DormRoom {
        +Long roomId
        +String roomNo
        +Long floorNo
        +Long capacity
        +String usageStatus
    }

    class Bed {
        +Long bedId
        +String bedNo
        +String managementStatus
        +Boolean canAssign()
    }

    class AccommodationAssignment {
        +Long assignmentId
        +LocalDate checkInDate
        +LocalDate checkOutDate
        +String relationStatus
        +String adjustmentReason
        +Boolean effectiveAt(LocalDate date)
        +terminate(LocalDate date)
    }

    class DormManagerBuildingScope {
        +Long scopeId
        +LocalDate startDate
        +LocalDate endDate
        +Boolean effectiveAt(LocalDate date)
    }

    SysUser "1" --> "0..1" StudentProfile : 学生资料
    SysUser "1" --> "0..1" DormManagerProfile : 宿管资料
    SysUser "1" --> "0..1" RepairerProfile : 维修人员资料
    SysUser "1" -- "0..*" UserRole : 拥有
    Role "1" -- "0..*" UserRole : 被分配
    Role "1" -- "0..*" RolePermission : 配置
    Permission "1" -- "0..*" RolePermission : 被授予

    DormManagerProfile "1" -- "0..*" DormManagerBuildingScope : 管辖
    Building "1" -- "0..*" DormManagerBuildingScope : 被管辖
    Building "1" *-- "1..*" DormRoom : 包含
    DormRoom "1" *-- "1..*" Bed : 包含
    StudentProfile "1" -- "0..*" AccommodationAssignment : 住宿历史
    Bed "1" -- "0..*" AccommodationAssignment : 被分配

    note for SysUser "当前系统管理员通过 Role=ADMIN 表达；若后续出现管理员专有属性或行为，再增加 AdminProfile"
    note for AccommodationAssignment "有效记录推导当前床位占用；历史记录保留调宿和退宿过程"
