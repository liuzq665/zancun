flowchart TB
    root[com.dorm.mis]

    subgraph foundation[基础支撑包]
        common[common<br/>Result / PageResult / BizException]
        config[config<br/>Spring / MyBatis / Jackson 配置]
        security[security<br/>JWT / 当前用户 / 权限]
        job[job<br/>定时任务]
    end

    subgraph domains[业务域包]
        auth[auth<br/>账号权限]
        dorm[dorm<br/>住宿基础]
        repair[repair<br/>报修业务]
        stay[stay<br/>假期留宿]
        notice[notice<br/>消息通知]
        file[file<br/>文件资源]
        system[system<br/>系统通用]
        statistics[statistics<br/>统计查询]
    end

    subgraph layers[域内分层]
        controller[controller<br/>请求接入]
        dto[dto / vo<br/>接口边界对象]
        service[service<br/>业务编排]
        entity[entity / rule<br/>领域对象与规则]
        mapper[mapper<br/>持久化访问]
    end

    root --> foundation
    root --> domains
    domains --> layers

    controller --> dto
    controller --> service
    service --> entity
    service --> mapper
    service --> common
    mapper --> entity

    security --> auth
    security --> common
    config --> common
    job --> service

    auth --> common
    dorm --> common
    repair --> common
    stay --> common
    notice --> common
    file --> common
    system --> common
    statistics --> common

    repair --> auth
    repair --> dorm
    repair --> notice
    repair --> file
    stay --> auth
    stay --> dorm
    stay --> notice
    stay --> file
    notice --> auth
    notice --> dorm
    system --> auth
    system --> file
    statistics --> auth
    statistics --> dorm
    statistics --> repair
    statistics --> stay

    classDef rootStyle fill:#16324f,color:#fff,stroke:#16324f
    classDef foundationStyle fill:#f2eafa,stroke:#7b5ca7,color:#111
    classDef domainStyle fill:#eaf8ea,stroke:#4f8a4f,color:#111
    classDef layerStyle fill:#e8f4ff,stroke:#39739d,color:#111

    class root rootStyle
    class common,config,security,job foundationStyle
    class auth,dorm,repair,stay,notice,file,system,statistics domainStyle
    class controller,dto,service,entity,mapper layerStyle
