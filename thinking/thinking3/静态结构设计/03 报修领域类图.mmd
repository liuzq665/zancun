classDiagram
    direction TB

    class FaultCategory {
        +Long categoryId
        +String name
        +Boolean inCampusScope
        +Boolean enabled
    }

    class RepairWorkType {
        +Long workTypeId
        +String name
        +Boolean enabled
    }

    class RepairRule {
        +Long ruleId
        +String name
        +Long acceptTimeoutMinutes
        +Long normalRepairMinutes
        +Long urgentRepairMinutes
        +Long confirmTimeoutDays
        +Long maxReworkCount
        +LocalDateTime effectiveFrom
        +LocalDateTime effectiveTo
        +Boolean enabled
        +checkRepairDeadline(Boolean urgent) LocalDateTime
    }

    class FaultWorkTypeConfig {
        +Long configId
        +LocalDateTime effectiveAt
        +Boolean enabled
    }

    class RepairerWorkTypeQualification {
        +Long qualificationId
        +String qualificationLevel
        +LocalDate validFrom
        +LocalDate validTo
        +Boolean effectiveAt(LocalDate date)
    }

    class RepairerBuildingScope {
        +Long scopeId
        +LocalDate startDate
        +LocalDate endDate
        +Boolean effectiveAt(LocalDate date)
    }

    class RepairOrder {
        +Long orderId
        +String orderNo
        +RepairOrderStatus status
        +Boolean urgent
        +Boolean abnormal
        +LocalDateTime createdAt
        +LocalDateTime archivedAt
        +submit()
        +auditPass()
        +markUrgent()
        +complete()
        +confirm()
        +canRework() Boolean
    }

    class RepairSubmissionVersion {
        +Long versionId
        +Long versionNo
        +String faultDescription
        +String studentRemark
        +LocalDateTime submittedAt
        +SubmissionStatus status
        +submit()
    }

    class RepairAuditRecord {
        +Long auditId
        +String conclusion
        +String reason
        +LocalDateTime auditedAt
        +String stage
    }

    class DispatchRecord {
        +Long dispatchId
        +String dispatchMode
        +DispatchStatus status
        +String rejectReason
        +LocalDateTime dispatchedAt
        +LocalDateTime acceptedAt
        +LocalDateTime timeoutAt
        +accept()
        +reject(String reason)
        +markTimeout()
    }

    class RepairDelayApplication {
        +Long delayId
        +String reason
        +LocalDateTime expectedFinishAt
        +String reviewConclusion
        +String reviewReason
        +LocalDateTime reviewedAt
        +approve()
        +reject(String reason)
    }

    class RepairResult {
        +Long resultId
        +String description
        +LocalDateTime submittedAt
        +submit()
    }

    class RepairConfirmation {
        +Long confirmationId
        +String confirmationMode
        +LocalDateTime confirmedAt
        +String opinion
        +confirm()
    }

    class RepairEvaluation {
        +Long evaluationId
        +Integer score
        +String content
        +LocalDateTime evaluatedAt
        +validateScore()
    }

    class WorkOrderExceptionRecord {
        +Long exceptionId
        +String exceptionType
        +String description
        +LocalDateTime occurredAt
        +record()
    }

    class FileResource {
        +Long fileId
        +String originalName
        +String storageName
        +String accessUrl
        +String fileType
        +Long size
        +String status
    }

    class SysUser {
        +Long userId
        +String realName
    }

    class StudentProfile {
        +Long studentProfileId
        +String studentNo
    }

    class DormRoom {
        +Long roomId
        +String roomNo
    }

    class RepairerProfile {
        +Long repairerProfileId
        +String employeeNo
    }

    class Building {
        +Long buildingId
        +String name
    }

    class RepairOrderStatus {
        <<enumeration>>
        DRAFT
        PENDING_AUDIT
        PENDING_EDIT
        PENDING_DISPATCH
        DISPATCHED
        IN_PROGRESS
        PENDING_CONFIRM
        CONFIRMED
        ARCHIVED
        CLOSED
    }

    class SubmissionStatus {
        <<enumeration>>
        DRAFT
        SUBMITTED
        REJECTED
        CURRENT
    }

    class DispatchStatus {
        <<enumeration>>
        WAITING
        ACCEPTED
        REJECTED
        TIMEOUT
        CANCELLED
    }

    StudentProfile "1" --> "0..*" RepairOrder : 提交
    DormRoom "1" --> "0..*" RepairOrder : 发生于
    FaultCategory "1" --> "0..*" RepairOrder : 归类
    RepairWorkType "1" --> "0..*" RepairOrder : 要求
    RepairRule "1" --> "0..*" RepairOrder : 适用
    RepairOrder "1" *-- "1..*" RepairSubmissionVersion : 形成版本
    RepairSubmissionVersion "1" *-- "0..*" FileResource : 关联故障图片
    RepairSubmissionVersion "1" *-- "0..*" RepairAuditRecord : 审核历史
    RepairOrder "1" *-- "0..*" DispatchRecord : 派单历史
    RepairerProfile "1" --> "0..*" DispatchRecord : 接收
    RepairOrder "1" *-- "0..*" RepairDelayApplication : 产生延期申请
    RepairOrder "1" *-- "0..1" RepairResult : 产生结果
    RepairResult "1" *-- "0..*" FileResource : 关联完工照片
    RepairResult "1" --> "0..1" RepairConfirmation : 等待确认
    RepairConfirmation "1" --> "0..1" RepairEvaluation : 产生评价
    RepairOrder "1" *-- "0..*" WorkOrderExceptionRecord : 记录异常
    RepairDelayApplication "1" *-- "0..*" FileResource : 关联现场照片
    RepairOrder "1" --> "0..*" RepairOrder : 原工单产生重修工单

    FaultCategory "1" -- "0..*" FaultWorkTypeConfig : 配置
    RepairWorkType "1" -- "0..*" FaultWorkTypeConfig : 被匹配
    RepairerProfile "1" -- "0..*" RepairerWorkTypeQualification : 具备资质
    RepairWorkType "1" -- "0..*" RepairerWorkTypeQualification : 对应工种
    RepairerProfile "1" -- "0..*" RepairerBuildingScope : 负责范围
    Building "1" -- "0..*" RepairerBuildingScope : 被覆盖

    RepairOrder --> RepairOrderStatus : 当前状态
    RepairSubmissionVersion --> SubmissionStatus : 版本状态
    DispatchRecord --> DispatchStatus : 派单状态
    SysUser "1" --> "0..*" RepairAuditRecord : 审核人
