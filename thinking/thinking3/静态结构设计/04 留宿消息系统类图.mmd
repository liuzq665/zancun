classDiagram
    direction LR

    class StayBatch {
        +Long batchId
        +String name
        +String holidayType
        +LocalDate openStartDate
        +LocalDate openEndDate
        +String status
        +publish()
        +archive()
    }

    class StayBatchBuildingRule {
        +Long ruleId
        +LocalDateTime deadline
        +Boolean autoLock
        +LocalDateTime resubmitDeadline
        +String buildingRemark
        +String status
        +lock()
    }

    class StayApplication {
        +Long applicationId
        +String source
        +String status
        +Boolean locked
        +String archiveReason
        +LocalDateTime createdAt
        +submit()
        +lock()
        +approve()
        +reject(String reason)
        +resubmit()
        +archive()
    }

    class StaySubmissionVersion {
        +Long versionId
        +Long versionNo
        +String description
        +LocalDateTime submittedAt
        +String status
        +submit()
    }

    class StayDateRange {
        +Long rangeId
        +LocalDate startDate
        +LocalDate endDate
        +validateWithinBatch()
    }

    class StayReviewRecord {
        +Long reviewId
        +String conclusion
        +String reason
        +LocalDateTime reviewedAt
        +Long roundNo
        +approve()
        +reject(String reason)
    }

    class SiteMessage {
        +Long messageId
        +String title
        +String body
        +String messageType
        +LocalDateTime publishedAt
        +String sendStatus
        +publish()
    }

    class MessageTarget {
        +Long targetId
        +String targetType
        +String description
        +resolveUsers() List~Long~
    }

    class MessageReceipt {
        +Long receiptId
        +Boolean read
        +LocalDateTime readAt
        +markRead()
    }

    class FileResource {
        +Long fileId
        +String originalName
        +String accessUrl
        +String fileType
    }

    class LoginLog {
        +Long logId
        +LocalDateTime loginAt
        +String result
        +String sourceAddress
        +String deviceInfo
        +String failureReason
    }

    class ImportExportTask {
        +Long taskId
        +String taskNo
        +String taskType
        +String objectType
        +String status
        +LocalDateTime startedAt
        +LocalDateTime finishedAt
        +run()
        +cancel()
    }

    class ImportErrorDetail {
        +Long detailId
        +Long rowNo
        +String fieldName
        +String reason
    }

    class BackupTask {
        +Long taskId
        +String taskNo
        +String taskType
        +String backupScope
        +String status
        +Long size
        +Boolean checksumPassed
        +run()
        +restore()
    }

    class OperationLog {
        +Long logId
        +LocalDateTime operatedAt
        +String module
        +String operationType
        +String objectType
        +Long objectId
        +String result
        +String description
    }

    class SysUser {
        +Long userId
        +String realName
    }

    class StudentProfile {
        +Long studentProfileId
        +String studentNo
    }

    class Building {
        +Long buildingId
        +String name
    }

    StayBatch "1" *-- "1..*" StayBatchBuildingRule : 配置楼栋规则
    Building "1" --> "0..*" StayBatchBuildingRule : 适用楼栋
    StayBatchBuildingRule "1" --> "0..*" StayApplication : 接收申请
    StudentProfile "1" --> "0..*" StayApplication : 提交
    StayApplication "1" *-- "1..*" StaySubmissionVersion : 形成版本
    StaySubmissionVersion "1" *-- "1..*" StayDateRange : 包含日期段
    StayApplication "1" *-- "0..*" StayReviewRecord : 审核历史
    SysUser "1" --> "0..*" StayReviewRecord : 审核人

    SiteMessage "1" *-- "0..*" MessageTarget : 设置目标
    SiteMessage "1" *-- "0..*" MessageReceipt : 生成接收记录
    SysUser "1" --> "0..*" MessageReceipt : 接收
    SysUser "0..1" --> "0..*" MessageTarget : 指定用户目标
    Building "0..1" --> "0..*" MessageTarget : 楼栋目标
    Role "0..1" --> "0..*" MessageTarget : 角色目标
    SiteMessage "1" -- "0..*" FileResource : 关联附件

    LoginLog "0..*" --> "0..1" SysUser : 关联账号
    SysUser "0..1" --> "0..*" ImportExportTask : 发起
    ImportExportTask "1" *-- "0..*" ImportErrorDetail : 产生错误明细
    ImportExportTask "1" -- "0..*" FileResource : 关联输入输出文件
    SysUser "0..1" --> "0..*" BackupTask : 发起
    BackupTask "1" -- "0..*" FileResource : 产生备份文件
    SysUser "1" --> "0..*" OperationLog : 产生

    note for LoginLog "账号不存在的登录失败可以没有对应 SysUser"
    note for OperationLog "objectType + objectId 是审计信息，不强行关联所有业务类"
    class Role {
        +Long roleId
        +String code
        +String name
    }
    note for MessageTarget "目标类型互斥：全体目标不关联对象；角色、楼栋、指定用户目标各关联对应对象之一"
