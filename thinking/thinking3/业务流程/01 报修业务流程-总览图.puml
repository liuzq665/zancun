@startuml
' 报修业务流程总览图
' 用于正文展示，异常、延期和重修流程见对应详细分图
title 报修业务流程总览图

skinparam shadowing false
skinparam defaultFontSize 14
skinparam activityFontSize 14
skinparam activityMessageFontSize 13
skinparam activityDiamondFontSize 13
skinparam ArrowColor #666666
!pragma useVerticalIf on

|#LightSteelBlue|系统管理员|
start
:维护故障分类、维修类型、人员负责范围和业务时限;

|#PaleGreen|学生|
:填写并提交报修工单;
:工单进入“待审核”;

|#AntiqueWhite|宿管|
:审核报修工单;
if (审核通过？) then (是)
  :工单进入“待派单”;
else (否)
  :填写驳回原因;
  :工单进入“待修改”;
  |#PaleGreen|学生|
  :修改原工单并重新提交;
  :返回审核流程;
endif

|#LightSteelBlue|系统管理员|
if (紧急工单或异常工单？) then (是)
  :进入手动派单池;
else (否)
  :进入自动派单池;
endif

if (派单成功？) then (是)
  :工单进入“已接单”;
else (否)
  :进入“待人工处理”;
  stop
endif

|#AntiqueWhite|维修人员|
:现场检查并处理故障;
if (一次维修完成？) then (是)
  :提交维修结果和完工照片;
  :工单进入“已维修”;
else (否)
  :进入“维修延期”流程;
endif

|#PaleGreen|学生|
:查看维修结果;
if (申请重修？) then (是)
  :进入重修流程;
else (否)
  if (确认维修完成？) then (是)
    :确认完成并评价;
  else (否)
    if (确认超时？) then (是)
      :系统自动确认维修完成;
    else (否)
      :等待学生确认;
    endif
  endif
  :工单进入“已确认”;
  :系统归档工单;
endif
stop
@enduml