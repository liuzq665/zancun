@startuml
' 报修业务流程活动泳道图
title 报修业务流程活动泳道图
scale 0.7
!pragma useVerticalIf on
skinparam defaultFontSize 10

|#LightSteelBlue|系统管理员|
start
:维护故障分类、维修类型和维修人员负责范围;
:配置维修人员负荷规则;
:配置未接单、维修完成和学生确认时限;
:配置重修次数上限;

|#PaleGreen|学生|
:填写报修工单;
:保存工单，状态为“待编辑”;
if (是否提交工单？) then (是)
  :提交工单;
  :工单状态变为“待审核”;
else (否)
  :继续编辑或保存草稿;
  stop
endif

|#AntiqueWhite|宿管|
:查看待审核工单;
:检查报修内容、故障类型、维修范围和材料;
if (是否属于校内维修范围？) then (是)
  :审核通过;
  :工单状态变为“待派单”;
  if (是否标记为紧急工单？) then (是)
    :工单进入手动派单池;
  else (否)
    :工单进入自动派单池;
  endif
else (否)
  :填写驳回原因;
  :记录审核结论“已驳回”;
  :工单状态变为“待修改”;
  :通知学生修改并重新提交;
endif

while (工单尚未进入已接单或结束状态？) is (是)
  |#PaleGreen|学生|
  if (工单当前状态为“待修改”？) then (是)
    if (是否已满7天未重新提交？) then (是)
      :系统记录“待修改超时自动关闭”;
      :工单状态变为“已关闭”;
      :工单归档;
      stop
    else (否)
      :根据驳回原因修改原工单;
      if (是否重新提交？) then (是)
        :重新提交原工单;
        :工单状态变为“待审核”;
      else (否)
        :继续编辑或保存;
      endif
    endif
  endif

  |#AntiqueWhite|宿管|
  if (工单状态为“待审核”？) then (是)
    :重新审核工单;
    if (审核通过？) then (是)
      :工单状态变为“待派单”;
      if (是否标记为紧急工单？) then (是)
        :工单进入手动派单池;
      else (否)
        :工单进入自动派单池;
      endif
    else (否)
      :填写驳回原因;
      :记录审核结论“已驳回”;
      :工单状态变为“待修改”;
      :通知学生修改并重新提交;
    endif
  endif

  if (工单进入自动派单池？) then (是)
    |#LightSteelBlue|系统管理员|
    :按维修工种、故障类型和负责范围筛选人员;
    :排除已经拒绝过该工单的维修人员;
    :按当前工单数选择未尝试的合适人员;
    if (是否有未尝试的合适维修人员？) then (是)
      :自动派单;
      :工单状态变为“待接单”;
      |#AntiqueWhite|维修人员|
      :查看工单详情;
      if (是否确认接单？) then (是)
        :确认接单;
        :工单状态变为“已接单”;
      else (否)
        if (是否拒绝接单？) then (是)
          :填写拒单原因;
          :拒单次数分别累计;
          |#LightSteelBlue|系统管理员|
          :记录本次拒单;
          if (拒单次数 + 超时未处理次数 > 2？) then (是)
            :标记为异常工单;
            :工单进入手动派单池;
          else (否)
            if (是否仍有未尝试人员？) then (是)
              :工单回到自动派单池;
            else (否)
              :工单进入“待人工处理：无可派人员”;
            endif
          endif
        else (超时未接单)
          :记录一次超时未处理;
          |#LightSteelBlue|系统管理员|
          :超时未处理次数分别累计;
          if (拒单次数 + 超时未处理次数 > 2？) then (是)
            :标记为异常工单;
            :工单进入手动派单池;
          else (否)
            if (是否仍有未尝试人员？) then (是)
              :工单回到自动派单池;
            else (否)
              :工单进入“待人工处理：无可派人员”;
            endif
          endif
        endif
      endif
    else (否)
      :工单进入“待人工处理：无可派人员”;
    endif
  endif

  |#AntiqueWhite|宿管|
  if (工单进入手动派单池？) then (是)
    :查看故障类型、维修范围和维修人员当前工单数;
    if (是否找到符合资质的维修人员？) then (是)
      :执行手动强制派单;
      |#AntiqueWhite|维修人员|
      :系统自动确认接单;
      :工单状态变为“已接单”;
    else (否)
      :工单进入“待人工处理”;
    endif
  endif

  |#LightSteelBlue|系统管理员|
  if (工单处于“待人工处理”？) then (是)
    if (属于校内范围但暂时无匹配人员？) then (是)
      :补充维修人员或调整负责范围;
      :工单重新进入派单池;
    else (否)
      :通知宿管按审核驳回流程处理;
      :工单状态变为“待修改”;
    endif
  endif
endwhile (否)

|#AntiqueWhite|维修人员|
:查看工单详情并到现场检查故障;
if (是否可以一次完成维修？) then (是)
  :完成现场维修;
  :填写维修结果并上传完工照片;
  :工单状态变为“已维修”;
else (否)
  :填写延期原因、现场照片和预计修好时间;
  :工单状态变为“维修延期”;
  :提交延期申请;
  |#AntiqueWhite|宿管|
  :审核延期申请;
  if (延期审核通过？) then (是)
    :通知学生延期审核通过;
    |#AntiqueWhite|维修人员|
    :继续负责该工单;
    :按审核通过的预计修好时间继续维修;
    if (预计时间前完成维修？) then (是)
      :填写维修结果并上传完工照片;
      :工单状态变为“已维修”;
    else (否)
      :记录一次超时未修好;
      :解除原维修人员负责关系;
      :标记为异常工单;
      :工单进入手动派单池;
      |#AntiqueWhite|宿管|
      :执行手动强制派单;
      |#AntiqueWhite|维修人员|
      :自动接单并继续维修;
    endif
  else (否)
    :工单恢复为“已接单”;
    :原维修人员负责关系保持不变;
    if (原维修截止时间已经到达？) then (是)
      :立即记录一次超时未修好;
      :解除原维修人员负责关系;
      :标记为异常工单;
      :工单进入手动派单池;
    else (否)
      :按原维修截止时间继续维修;
    endif
  endif
endif

|#PaleGreen|学生|
:查看维修结果和完工照片;
if (是否在确认前申请重修？) then (是)
  :发起重修申请;
  :系统保留原工单;
  :生成关联的重修工单;
  :重修工单状态变为“待审核”;

  |#AntiqueWhite|宿管|
  :审核重修工单;
  if (是否达到重修次数上限？) then (是)
    :提示“已达到重修次数上限”;
    |#PaleGreen|学生|
    :如仍有问题，新建报修工单;
    stop
  else (否)
    if (审核通过？) then (是)
      :重修工单进入手动派单池;
      :执行手动强制派单;
      |#AntiqueWhite|维修人员|
      :自动接单并重新维修;
      :返回现场维修流程;
    else (否)
      :填写驳回原因;
      :重修工单状态变为“待修改”;
      :通知学生修改重修工单并重新提交;
      if (7天未重新提交？) then (是)
        :重修工单变为“已关闭”并归档;
        stop
      else (否)
        |#PaleGreen|学生|
        :修改重修工单并重新提交;
        :重修工单回到“待审核”;
      endif
    endif
  endif
else (否)
  if (学生确认维修完成？) then (是)
    :确认维修完成;
    :提交维修评价;
    |#LightSteelBlue|系统管理员|
    :工单归档;
    stop
  else (否)
    if (超时未确认？) then (是)
      :系统自动确认维修完成;
      :工单归档;
      stop
    endif
  endif
endif
@enduml