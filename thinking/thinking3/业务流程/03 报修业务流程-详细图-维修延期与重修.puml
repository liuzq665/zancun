@startuml
' 报修业务详细分图：维修延期与重修
title 报修业务详细流程：维修延期与重修

skinparam shadowing false
skinparam defaultFontSize 13
skinparam activityFontSize 13
skinparam activityMessageFontSize 12
skinparam activityDiamondFontSize 12
skinparam ArrowColor #666666
!pragma useVerticalIf on

|#AntiqueWhite|维修人员|
start
:工单处于“已接单”;
:现场检查故障;
if (本次可以完成维修？) then (是)
  :完成维修并上传维修结果、完工照片;
  :工单进入“已维修”;
else (否)
  :填写延期原因、现场照片和预计修好时间;
  :工单进入“维修延期”;
  :提交延期申请;
endif

|#AntiqueWhite|宿管|
:审核延期申请;
if (延期审核通过？) then (是)
  :通知学生延期审核通过;
  |#AntiqueWhite|维修人员|
  :原维修人员继续负责;
  :按照审核通过的预计时间继续维修;
  if (预计时间到达前完成？) then (是)
    :提交维修结果和完工照片;
    :工单进入“已维修”;
  else (否)
    |#LightSteelBlue|系统管理员|
    :记录一次超时未修好;
    :解除原维修人员负责关系;
    :标记为“异常工单”;
    :工单进入手动派单池;
    |#AntiqueWhite|宿管|
    :手动强制派单;
    |#AntiqueWhite|维修人员|
    :系统自动确认接单;
    :继续维修;
  endif
else (否)
  :工单恢复为“已接单”;
  note right
    延期审核期间暂停超时计时，原负责关系不解除。
  end note
  |#LightSteelBlue|系统管理员|
  if (原维修截止时间已经到达？) then (是)
    :立即记录一次超时未修好;
    :解除原维修人员负责关系;
    :标记为“异常工单”;
    :工单进入手动派单池;
  else (否)
    :按原维修截止时间继续计时;
  endif
endif

|#PaleGreen|学生|
:查看维修结果和完工照片;
if (学生在确认前申请重修？) then (是)
  :发起重修申请;
  :原工单保留;
  :生成关联的重修工单;
  :重修工单进入“待审核”;
  |#AntiqueWhite|宿管|
  :审核重修工单;
  if (达到重修次数上限？) then (是)
    :提示已达到重修次数上限;
    |#PaleGreen|学生|
    :如仍有问题，新建报修工单;
  else (否)
    if (审核通过？) then (是)
      :重修工单跳过自动派单;
      :进入手动派单池;
      |#AntiqueWhite|维修人员|
      :系统自动确认接单;
      :重新维修;
    else (否)
      :填写驳回原因;
      :重修工单进入“待修改”;
      |#PaleGreen|学生|
      label L_REWORK
      if (7天内重新提交？) then (是)
        :修改原重修工单并重新提交;
        ->L_REWORK_BACK
      else (否)
        |#LightSteelBlue|系统管理员|
        :记录“待修改超时自动确认”;
        :重修工单进入“已确认”并归档;
      endif
      label L_REWORK_BACK
      :返回报修审核流程;
    endif
  endif
else (否)
  if (学生确认维修完成？) then (是)
    :确认完成并评价;
  else (否)
    if (7天内未确认？) then (是)
      |#LightSteelBlue|系统管理员|
      :自动确认维修完成;
    else (否)
      :等待学生确认;
    endif
  endif
  :工单归档;
endif
stop
@enduml