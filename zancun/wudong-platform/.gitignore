coverage/
.nyc_output/

# TypeScript 编译输出
*.tsbuildinfo

# MidwayJS 缓存
.midway/

# npm/yarn/pnpm lock files（如果有私有包需要保留）
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

